{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/main-moved.sh SessionStart fetch",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/main-moved.sh PostToolUse",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(gh pr merge*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/main-moved.sh PostToolUse fetch",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
