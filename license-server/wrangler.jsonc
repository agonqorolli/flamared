{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flamared-license-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // The website's Download, the app's Buy and Renew buttons and Stripe's webhook use these addresses; the rest of
  // flamared.com is untouched.
  "routes": [
    { "pattern": "flamared.com/download", "zone_name": "flamared.com" },
    { "pattern": "flamared.com/buy", "zone_name": "flamared.com" },
    { "pattern": "flamared.com/renew", "zone_name": "flamared.com" },
    { "pattern": "flamared.com/stripe/webhook", "zone_name": "flamared.com" },
  ],
  // Licenses by email and handled orders. Make it with `npx wrangler kv namespace create LICENSES` and put its id here.
  "kv_namespaces": [{ "binding": "LICENSES", "id": "e699924aa219496f9e67ed0cc81b0789" }],
  // Secrets are set with `npx wrangler secret put <NAME>`, never written here: LICENSE_SIGNING_KEY,
  // STRIPE_WEBHOOK_SECRET, RESEND_API_KEY, and OWNER_EMAIL (kept out of this public file). For `wrangler dev`, put
  // them in .dev.vars (ignored by git).
  "vars": {
    // Live Stripe links (the sandbox ones are in the README, for testing).
    "BUY_LINK": "https://buy.stripe.com/dRm7sL4eO2GF3qA5ii0Jq00",
    "BUY_LINK_ID": "plink_1UdfOfIlhs75Sminf5bTFzIt",
    "RENEW_LINK": "https://buy.stripe.com/9B67sLdPoftr8KU1220Jq01",
    "RENEW_LINK_ID": "plink_1UdfOrIlhs75SminRoynFB8d",
    // The website's Download buttons go through /download to this (counted), the newest release's DMG.
    "DOWNLOAD_LINK": "https://github.com/agonqorolli/flamared/releases/latest/download/Flamared.dmg",
    "FROM_EMAIL": "Flamared <licenses@flamared.com>",
    // Buyers' replies; Cloudflare Email Routing forwards it to the owner.
    "REPLY_TO": "support@flamared.com",
    // The launch price: a Stripe promotion code for the LAUNCH-20 coupon, and its last day (YYYY-MM-DD).
    "LAUNCH_CODE": "LAUNCH",
    "LAUNCH_ENDS": "2026-12-31",
  },
}
